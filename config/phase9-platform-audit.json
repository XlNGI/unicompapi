{
  "schemaVersion": 1,
  "roots": ["electron", "scripts", "src"],
  "extensions": [".ts", ".tsx", ".mjs", ".cjs"],
  "rules": [
    {
      "id": "direct-runtime-platform-access",
      "owner": "B1-B3 platform composition and adapters",
      "pattern": "process\\.(?:platform|arch)",
      "allowedFiles": [
        "electron/ipc/runtime-media-engine.ts",
        "electron/ipc/settings-ipc.ts",
        "electron/ipc/settings-platform-adapters.ts",
        "electron/main.ts",
        "electron/preload.ts",
        "scripts/media-engine-common.mjs",
        "scripts/package-microsoft-store.mjs",
        "scripts/phase9-platform-common.mjs",
        "scripts/verify-runtime-integrations.cjs",
        "src/platform/documents/office-render-adapter.ts",
        "src/platform/ipc/settings-controller.ts",
        "src/platform/runtime/managed-process.ts",
        "src/platform/settings/cleanup-service.ts",
        "src/platform/settings/directory-migration.ts",
        "src/platform/settings/performance-policy.ts"
      ]
    },
    {
      "id": "platform-literal-in-production-code",
      "owner": "B1 inventory; later tasks keep literals inside contracts and adapters",
      "pattern": "['\"](?:win32|darwin|windows|macos)['\"]",
      "allowedFiles": [
        "electron/ipc/runtime-media-engine.ts",
        "electron/ipc/settings-ipc.ts",
        "electron/ipc/settings-platform-adapters.ts",
        "electron/main.ts",
        "scripts/collect-platform-evidence.mjs",
        "scripts/package-microsoft-store.mjs",
        "scripts/verify-production-media.mjs",
        "scripts/phase9-platform-common.mjs",
        "src/domain/entities/settings.ts",
        "src/pages/settings/SettingsPage.tsx",
        "src/platform/acceptance/platform-acceptance.ts",
        "src/platform/documents/office-render-adapter.ts",
        "src/platform/ipc/settings-controller.ts",
        "src/platform/runtime/managed-process.ts",
        "src/platform/settings/cleanup-service.ts",
        "src/platform/settings/directory-migration.ts",
        "src/platform/settings/performance-policy.ts",
        "src/platform/settings/shortcut-service.ts",
        "src/shared/settings-ipc.ts",
        "src/ui/layout/TitleBar.tsx"
      ]
    }
  ]
}
