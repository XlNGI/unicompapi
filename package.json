{
  "name": "unicomp-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "UniComp desktop application built with Electron, React and TypeScript.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs tests/ui/*.test.mjs && vitest run tests/domain",
    "test:ui-contract": "node --test tests/*.test.mjs",
    "test:domain": "vitest run tests/domain",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "start": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "2.1.9",
    "wait-on": "^8.0.1"
  }
}
