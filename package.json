{
  "name": "unicomp-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "UniComp desktop application built with Electron, React and TypeScript.",
  "license": "Apache-2.0",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:app": "tsc -p electron/tsconfig.json && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "setup:media-engine": "node scripts/setup-media-engine.mjs",
    "verify:media-engine": "node scripts/verify-media-engine.mjs",
    "package:win": "pnpm build && electron-builder --win nsis --config electron-builder.yml",
    "package:win:dir": "pnpm build && electron-builder --win dir --config electron-builder.yml",
    "verify:handoff": "node scripts/verify-handoff.mjs",
    "audit:platform": "node scripts/audit-platform-assumptions.mjs",
    "verify:recovery-audit": "node scripts/verify-phase9-recovery-audit.mjs",
    "verify:phase9-closeout": "node scripts/verify-phase9-closeout.mjs",
    "collect:platform-evidence": "node scripts/collect-platform-evidence.mjs",
    "verify:secure-storage": "electron scripts/verify-secure-storage.cjs",
    "verify:runtime-integrations": "electron scripts/verify-runtime-integrations.cjs",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json && node scripts/copy-document-templates.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs tests/ui/*.test.mjs && vitest run tests/application tests/domain tests/platform validation tests/evaluation",
    "test:ui-contract": "node --test tests/*.test.mjs",
    "test:domain": "vitest run tests/domain",
    "test:platform": "vitest run tests/platform",
    "test:application": "vitest run tests/application",
    "test:read-model-performance": "vitest run tests/platform/read-model-performance-baseline.test.ts",
    "test:vidu-e2e": "vitest run tests/platform/vidu-e2e-validation.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "start": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rsuite": "6.2.2",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "adm-zip": "^0.6.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "2.1.9",
    "wait-on": "^8.0.1"
  }
}
